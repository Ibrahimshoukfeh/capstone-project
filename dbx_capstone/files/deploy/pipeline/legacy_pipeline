trigger:
  branches:
    include:
      - main
  tags:
    include:
      - "*.*.*"

stages:
  - stage: DeployToDev
    displayName: "Deploy to Dev"
    #variables:
      #- group: Dev-Variables

    jobs:
      - deployment: DeployDev
        environment: Dev
        strategy:
          runOnce:
            deploy:
              steps:
                - checkout: self

                - task: AzureCLI@2
                  inputs:
                    azureSubscription: RG-AG-UKS-DBK-UK-DEV
                    scriptType: ps
                    scriptLocation: inlineScript
                    inlineScript: |
                      $env:PATH +=';C:\Tools;C:\Program Files\terraform;C:\Tools\registry.terraform.io\databricks\databricks\1.85.0\windows_amd64;C:\Users\plantation.VMUKSADSBA01\AppData\Local\Programs\Python\Python312\Scripts'
                      $env:Build_Repository_Name = "$(Build.Repository.Name)"

                      $env:DATABRICKS_TF_VERSION=1.5.5
                      $env:DATABRICKS_TF_EXEC_PATH='C:\Program Files\terraform\terraform.exe'
                      $env:DATABRICKS_TF_CLI_CONFIG_FILE='$(Build.SourcesDirectory)\deploy\bundle\config.tfrc'

                      $env:DATABRICKS_TOKEN=$(az account get-access-token --resource 2ff814a6-3304-4ab8-85cb-cd0e6f879c1d --query "accessToken"  --output tsv)

                      databricks --version
                      terraform --version
                      py --version

                      tree /F 'C:\Tools\registry.terraform.io\databricks\databricks'

                      Write-Host "PATH = $($env:PATH)"

                      databricks bundle validate --target dev

                  displayName: "Validate DAB Package"

                - task: AzureCLI@2
                  inputs:
                    azureSubscription: RG-AG-UKS-DBK-UK-DEV
                    scriptType: ps
                    scriptLocation: inlineScript
                    inlineScript: |
                      $env:PATH +=';C:\Tools;C:\Program Files\terraform;C:\Tools\registry.terraform.io\databricks\databricks\1.85.0\windows_amd64;C:\Users\plantation.VMUKSADSBA01\AppData\Local\Programs\Python\Python312\Scripts'
                      $env:Build_Repository_Name = "$(Build.Repository.Name)"

                      $env:DATABRICKS_TF_VERSION=1.5.5
                      $env:DATABRICKS_TF_EXEC_PATH='C:\Program Files\terraform\terraform.exe'
                      $env:DATABRICKS_TF_CLI_CONFIG_FILE='$(Build.SourcesDirectory)\deploy\bundle\config.tfrc'

                      $env:DATABRICKS_TOKEN=$(az account get-access-token --resource 2ff814a6-3304-4ab8-85cb-cd0e6f879c1d --query "accessToken"  --output tsv)

                      databricks bundle deploy --target dev

                  displayName: "Deploy DAB Package"

                - task: AzureCLI@2
                  inputs:
                    azureSubscription: RG-AG-UKS-DBK-UK-DEV
                    scriptType: ps
                    scriptLocation: inlineScript
                    inlineScript: |
                      $env:PATH +=';C:\Tools;C:\Program Files\terraform;C:\Tools\registry.terraform.io\databricks\databricks\1.85.0\windows_amd64;'
                      $env:Build_Repository_Name = "$(Build.Repository.Name)"

                      $env:DATABRICKS_TF_VERSION=1.5.5
                      $env:DATABRICKS_TF_EXEC_PATH='C:\Program Files\terraform\terraform.exe'
                      $env:DATABRICKS_TF_CLI_CONFIG_FILE='$(Build.SourcesDirectory)\deploy\bundle\config.tfrc'

                      $env:DATABRICKS_TOKEN=$(az account get-access-token --resource 2ff814a6-3304-4ab8-85cb-cd0e6f879c1d --query "accessToken"  --output tsv)

                      databricks bundle run gew-env-prep-job --target dev

                  displayName: "Execute Environment Prep Job"
